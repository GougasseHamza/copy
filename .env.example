# Backend API
API_BASE_URL=http://localhost:8080/api

# Google Maps API Key (public - but MUST have domain restrictions in GCP Console)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# n8n Webhook (PRIVATE - should only be called from backend)
# Do NOT expose this in public runtime config
N8N_WEBHOOK_URL=your_n8n_webhook_url_here

# Add this to your .gitignore to keep actual values secret
